{
  "name": "log-aggregator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  }
}
